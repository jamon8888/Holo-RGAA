#!/usr/bin/env python3
"""Launcher for the shared user-level VPS agent harness.

The source root is the parent of this script's directory, both in the source
tree and in the versioned installed package.  ``AGENT_HARNESS_SOURCE_ROOT``
can override it when the installer is invoked from another checkout.
"""

import os
import sys
from pathlib import Path

_root = os.environ.get("AGENT_HARNESS_SOURCE_ROOT")
if _root:
    sys.path.insert(0, str(Path(_root).resolve()))
else:
    sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from agent_harness.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
