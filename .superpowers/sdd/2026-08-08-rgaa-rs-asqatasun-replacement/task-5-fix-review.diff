     pub async fn get_audit(&self, id: Uuid) -> anyhow::Result<Option<Value>> {
         let row: Option<(Value,)> = sqlx::query_as(
             r#"
             SELECT result FROM audits WHERE id = $1
             "#,
         )
         .bind(id)
         .fetch_optional(&self.pool)
         .await?;
         Ok(row.map(|(result,)| result))
