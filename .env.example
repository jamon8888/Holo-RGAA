# Holo-RGAA — configuration d'exemple.
#
# Copier vers `.env` : `cp .env.example .env`, puis renseigner les valeurs.
# Les binaires (rgaa-cli, rgaa-api, rgaa-tui, rgaa-mcp, rgaa-data) chargent ce
# fichier au démarrage. Une variable déjà présente dans l'environnement réel
# (docker, systemd, CI) l'emporte toujours sur ce qui est écrit ici.
#
# Ne jamais commiter le `.env` renseigné : il contient des clés d'API.

# =============================================================================
# LLM — un seul jeu de variables pour tous les providers
# =============================================================================

# Provider parmi : holo3, openai, openrouter, groq, mistral, deepseek,
# together, xai, ollama, lmstudio, vllm, custom.
# Chacun est une API compatible OpenAI ; la base_url est déduite du nom.
# Anthropic n'est pas dans la liste (son API Messages n'est pas compatible
# OpenAI) : passer par `openrouter` pour joindre les modèles Claude.
RGAA_LLM_PROVIDER=holo3

# Modèle par défaut. Obligatoire.
RGAA_LLM_MODEL=holo3-1-35b-a3b

# Clé d'API. Accepte soit cette variable générique, soit la variable native du
# provider (HOLO3_API_KEY, OPENAI_API_KEY, GROQ_API_KEY, ...). Inutile pour
# les providers locaux (ollama, lmstudio, vllm).
RGAA_LLM_API_KEY=

# Override de l'endpoint (sans `/chat/completions`). Vide = base_url du
# provider. Obligatoire avec RGAA_LLM_PROVIDER=custom.
# RGAA_LLM_BASE_URL=http://gpu-box:8000/v1

# Timeout par requête. Défaut : 30s pour une API distante, 600s pour un
# runtime local (l'inférence CPU d'un 7B-14B se compte en minutes).
# RGAA_LLM_TIMEOUT_SECS=600

# --- Multi-modèle par tier ---------------------------------------------------
# L'évaluateur route chaque critère vers un tier : `tactical` pour la majorité,
# `reasoning` pour les critères visuels et difficiles (et pour le vérificateur
# indépendant). Chaque tier non renseigné retombe sur RGAA_LLM_MODEL — laisser
# les deux vides donne le fonctionnement mono-modèle.
# RGAA_LLM_MODEL_TACTICAL=llama-3.1-8b-instant
# RGAA_LLM_MODEL_REASONING=llama-3.3-70b-versatile

# --- Route de secours (optionnelle) ------------------------------------------
# Utilisée uniquement par les chemins qui passent par rgaa_holo::BackendConfig
# (harness RAG, baselines). Renseigner RGAA_LLM_FALLBACK_PROVIDER active la
# bascule : les appels partent sur la route principale et ne touchent la
# seconde que si la première échoue après ses propres retries.
# Cette route se configure entièrement à part — aucune variable de la route
# principale ne déborde dessus, clé comprise.
# RGAA_LLM_FALLBACK_PROVIDER=ollama
# RGAA_LLM_FALLBACK_MODEL=qwen2.5:14b-instruct
# RGAA_LLM_FALLBACK_BASE_URL=
# RGAA_LLM_FALLBACK_API_KEY=

# --- Anciennes variables (toujours acceptées) --------------------------------
# HOLO3_API_KEY / HOLO3_BASE_URL / HOLO3_MODEL configurent la route principale
# et sélectionnent le provider `holo3`. Elles ne s'appliquent jamais à la route
# de secours.
# HOLO3_API_KEY=

# =============================================================================
# Débit
# =============================================================================
# Requêtes par minute autorisées sur chaque tier.
RGAA_TACTICAL_RPM=10
RGAA_REASONING_RPM=20

# =============================================================================
# Stockage
# =============================================================================
# DATABASE_URL=postgres://user:pass@localhost:5432/rgaa
# LANCEDB_PATH=./data/lancedb

# =============================================================================
# Exemples de configurations complètes
# =============================================================================
#
# 100 % local, aucun appel sortant :
#   RGAA_LLM_PROVIDER=ollama
#   RGAA_LLM_MODEL=qwen2.5:14b-instruct
#
# Groq, petit modèle pour le volume, gros pour le raisonnement :
#   RGAA_LLM_PROVIDER=groq
#   RGAA_LLM_API_KEY=gsk_...
#   RGAA_LLM_MODEL=llama-3.3-70b-versatile
#   RGAA_LLM_MODEL_TACTICAL=llama-3.1-8b-instant
#
# OpenRouter, avec Claude sur le tier raisonnement :
#   RGAA_LLM_PROVIDER=openrouter
#   RGAA_LLM_API_KEY=sk-or-...
#   RGAA_LLM_MODEL=mistralai/mistral-small
#   RGAA_LLM_MODEL_REASONING=anthropic/claude-sonnet-4.5
#
# vLLM auto-hébergé :
#   RGAA_LLM_PROVIDER=custom
#   RGAA_LLM_BASE_URL=http://gpu-box:8000/v1
#   RGAA_LLM_MODEL=Qwen/Qwen2.5-32B-Instruct
