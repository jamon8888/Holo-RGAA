{
  "$comment": "Generated by `cargo run -p rgaa-mcp --bin dump-tool-schemas`. Do not edit by hand.",
  "tools": [
    {
      "name": "analyze",
      "description": "Analyze a URL for RGAA accessibility findings. Returns detailed per-criterion findings with criterion_id, status (Pass/Fail/NeedsReview/NotTested/NotApplicable/Error), source (axe-core/gap-fix/holo3/manual), evidence, and justification. Note: Both Manuel and PartiellementAutomatable criteria map to NeedsReview status — watch this single status for human-review items.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$defs": {
          "AnalyzeConfigInput": {
            "type": "object",
            "properties": {
              "profile": {
                "type": "string",
                "default": "default"
              },
              "viewport_width": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0,
                "default": 1000
              },
              "viewport_height": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0,
                "default": 1080
              },
              "selector": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "pre_scan_actions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/PreScanActionInput"
                },
                "default": []
              },
              "cookies": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/CookieInput"
                },
                "default": []
              },
              "screenshot": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ScreenshotInput"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "timeout_ms": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint64",
                "minimum": 0,
                "default": null
              },
              "retry_limit": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint8",
                "minimum": 0,
                "maximum": 255,
                "default": null
              },
              "advanced_rules": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "igt_tools": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                },
                "default": null
              },
              "needs_review_policy": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/NeedsReviewPolicyInput"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              }
            }
          },
          "PreScanActionInput": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "selector": {
                    "type": "string"
                  },
                  "action": {
                    "type": "string",
                    "const": "click"
                  }
                },
                "required": [
                  "action",
                  "selector"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "selector": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  },
                  "action": {
                    "type": "string",
                    "const": "fill"
                  }
                },
                "required": [
                  "action",
                  "selector",
                  "value"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "selector": {
                    "type": "string"
                  },
                  "state": {
                    "$ref": "#/$defs/WaitForState",
                    "default": "visible"
                  },
                  "action": {
                    "type": "string",
                    "const": "wait_for"
                  }
                },
                "required": [
                  "action",
                  "selector"
                ]
              }
            ]
          },
          "WaitForState": {
            "type": "string",
            "enum": [
              "visible",
              "attached",
              "hidden",
              "detached"
            ]
          },
          "CookieInput": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string",
                "writeOnly": true
              },
              "domain": {
                "type": "string"
              },
              "path": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "same_site": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/SameSiteInput"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "secure": {
                "type": [
                  "boolean",
                  "null"
                ],
                "default": null
              },
              "http_only": {
                "type": [
                  "boolean",
                  "null"
                ],
                "default": null
              },
              "expires": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "int64",
                "default": null
              }
            },
            "required": [
              "name",
              "value",
              "domain"
            ]
          },
          "SameSiteInput": {
            "type": "string",
            "enum": [
              "strict",
              "lax",
              "none"
            ]
          },
          "ScreenshotInput": {
            "type": "object",
            "properties": {
              "format": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/ScreenshotFormat"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "save_to": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              },
              "save": {
                "type": [
                  "boolean",
                  "null"
                ],
                "default": null
              },
              "inline": {
                "type": [
                  "boolean",
                  "null"
                ],
                "default": null
              }
            }
          },
          "ScreenshotFormat": {
            "type": "string",
            "enum": [
              "png",
              "jpeg"
            ]
          },
          "NeedsReviewPolicyInput": {
            "type": "string",
            "enum": [
              "record",
              "fail"
            ]
          }
        },
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "config": {
            "$ref": "#/$defs/AnalyzeConfigInput",
            "default": {
              "profile": "default",
              "viewport_width": 1000,
              "viewport_height": 1080,
              "selector": null,
              "pre_scan_actions": [],
              "cookies": [],
              "screenshot": null,
              "timeout_ms": null,
              "retry_limit": null,
              "advanced_rules": null,
              "igt_tools": null,
              "needs_review_policy": null
            }
          },
          "viewport_width": {
            "type": [
              "integer",
              "null"
            ],
            "format": "uint32",
            "minimum": 0,
            "default": null
          },
          "viewport_height": {
            "type": [
              "integer",
              "null"
            ],
            "format": "uint32",
            "minimum": 0,
            "default": null
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "audit_url",
      "description": "Run a full RGAA audit on a URL using the orchestrator pipeline. Returns a summary (taux_global, etat_conformite) and sampled_page_urls. IMPORTANT: This returns a summary only — for per-criterion details with evidence, use the `analyze` tool on URLs from sampled_page_urls.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$defs": {
          "CrawlConfigInput": {
            "type": "object",
            "properties": {
              "max_pages": {
                "type": "integer",
                "format": "uint",
                "minimum": 0,
                "default": 50
              },
              "max_depth": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0,
                "default": 5
              },
              "respect_robots": {
                "type": "boolean",
                "default": true
              },
              "sample_mode": {
                "type": "boolean",
                "default": true
              }
            }
          }
        },
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "config": {
            "anyOf": [
              {
                "$ref": "#/$defs/CrawlConfigInput"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "name": "get_audit_result",
      "description": "Retrieve a previously run audit by its ID.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "required": [
          "audit_id"
        ],
        "type": "object",
        "properties": {
          "audit_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "igt",
      "description": "[DEPRECATED] Use `analyze` with `config.igt_tools: [\"keyboard\"]` instead. Run a bounded, reproducible intelligent guided accessibility test (keyboard navigation). Reports keyboard-trap after 5 consecutive tabs on the same element. Sets status: incomplete with terminated_reason: ExecutionError on CDP failures.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$defs": {
          "GuidedTestInput": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "version": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              "preconditions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "steps": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/GuidedStepDto"
                }
              },
              "criterion_mapping": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "evidence_requirements": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              }
            },
            "required": [
              "id",
              "version",
              "steps"
            ]
          },
          "GuidedStepDto": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "const": "navigate"
                  }
                },
                "required": [
                  "kind",
                  "url"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "accessibility_tree"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "const": "press_key"
                  }
                },
                "required": [
                  "kind",
                  "key"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "reference": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "const": "click_ref"
                  }
                },
                "required": [
                  "kind",
                  "reference"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "reference": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "const": "fill_ref"
                  }
                },
                "required": [
                  "kind",
                  "reference",
                  "value"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "screenshot"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "expected": true,
                  "kind": {
                    "type": "string",
                    "const": "assert_state"
                  }
                },
                "required": [
                  "kind",
                  "expected"
                ]
              }
            ]
          }
        },
        "type": "object",
        "properties": {
          "test": {
            "$ref": "#/$defs/GuidedTestInput"
          }
        },
        "required": [
          "test"
        ]
      }
    },
    {
      "name": "list_criteria",
      "description": "List all 106 RGAA criteria with their IDs, titles, and classifications.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "remediate",
      "description": "Create approval-gated remediation guidance for accessibility issues.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$defs": {
          "RemediationIssueInput": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              },
              "element_html": {
                "type": "string"
              },
              "page_url": {
                "type": "string"
              },
              "source_locations": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/SourceLocationInput"
                },
                "default": []
              },
              "summary": {
                "type": "string"
              },
              "remediation": {
                "type": "string"
              },
              "criteria": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "framework": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/FrameworkInput"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              }
            },
            "required": [
              "id",
              "rule",
              "element_html",
              "page_url",
              "summary",
              "remediation"
            ]
          },
          "SourceLocationInput": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              },
              "column": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint32",
                "minimum": 0,
                "default": null
              }
            },
            "required": [
              "file",
              "line"
            ]
          },
          "FrameworkInput": {
            "type": "string",
            "enum": [
              "react",
              "next",
              "vue",
              "angular"
            ]
          }
        },
        "type": "object",
        "properties": {
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/RemediationIssueInput"
            }
          }
        },
        "required": [
          "issues"
        ]
      }
    }
  ]
}
